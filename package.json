{
  "name": "ethpc",
  "version": "1.0.0",
  "description": "EthPC: an AI agent that shops for a gaming PC, pays for its data with x402 on Hedera inside an allowance you approve, reads shops from Arkiv, and gates reviews with World ID.",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning start.mjs",
    "test": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.mjs\"",
    "seed:arkiv": "node --env-file=.env -e \"import('./src/directory.mjs').then(m=>m.seedArkiv())\"",
    "setup:hedera": "node --env-file=.env scripts-setup-hedera.mjs",
    "verify": "node --env-file-if-exists=.env src/verify.mjs",
    "mcp": "node src/mcp.mjs",
    "seed:impostor": "node --env-file=.env -e \"import('./src/directory.mjs').then(m=>m.seedImpostor())\"",
    "setup:usdc": "node --env-file=.env scripts-setup-usdc.mjs",
    "test:usdc": "TEST_PAY_ASSET=usdc node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/guard.test.mjs",
    "setup:shops": "node --env-file=.env scripts-setup-shops.mjs",
    "shop": "node --env-file=.env scripts-shop.mjs",
    "seed:reviews": "node --env-file-if-exists=.env -e \"import('./src/reviews.mjs').then(m=>m.seedSampleReviews())\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@arkiv-network/sdk": "^1.0.1",
    "@hashgraph/hedera-agent-kit": "^4.2.0",
    "@hiero-ledger/sdk": "^2.90.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@x402/core": "^2.29.0",
    "@x402/express": "^2.29.0",
    "@x402/hedera": "^2.29.0",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "viem": "^2.57.14",
    "zod": "^4.6.7"
  },
  "type": "module",
  "private": true
}
