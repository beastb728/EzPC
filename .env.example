# Leave blank to run that integration in labelled simulated mode. Testnet values only.
# Setup account: used only by `npm run setup:hedera`, never by a running service.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# ECDSA or ED25519. Only needed if the key is raw hex.
HEDERA_KEY_TYPE=ECDSA
X402_FACILITATOR_URL=https://x402.org/facilitator
# What payments use: hbar (default) or usdc (testnet USDC, token 0.0.429274). For usdc, run `npm run setup:usdc` once
# and get test USDC for the demo wallet from https://faucet.circle.com (Hedera testnet).
PAY_ASSET=hbar
# Written by `npm run setup:hedera`: SELLER_*, GUARD_*, USER_* and HCS_TOPIC_ID
# Hard cap for any intent, in the asset's smallest unit (defaults to 5 HBAR or 5 USDC)
MAX_INTENT_UNITS=
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
# Set to the writer wallet printed by `npm run seed:arkiv`. Arkiv stays simulated until this is set.
APPROVED_OWNERS=
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# How the client was registered in World's portal: post (client_secret_post) or basic (client_secret_basic)
WORLD_CLIENT_AUTH=post
DATA_GOV_IN_API_KEY=
# Optional OpenAI-compatible model for the intent check and BriefWriter, such as the 0G router
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Who signs for the user: hashpack (the user approves in HashPack; needs a free WalletConnect project ID from dashboard.reown.com)
# or server (demo fallback: the dashboard server holds USER_PRIVATE_KEY and signs).
WALLET=hashpack
WALLETCONNECT_PROJECT_ID=

# Google sign-in (account access). Without both, sign-in is simulated: "Log in" signs in a local user.
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that OAuth client exactly. Default: http://localhost:4000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Signs the session cookie. Any long random string (e.g. `openssl rand -hex 32`). Without it, sessions end on restart.
SESSION_SECRET=
# Optional: only accept World ID results at this verification level, e.g. https://world.org/oidc/acr/orb. Leave empty to accept any.
WORLD_REQUIRED_ACR=
# Real World ID (production, https://auth.world.org): set WORLD_USE=production and fill these from the production
# portal (auth.world.org/portal). Remove WORLD_USE to go back to the sandbox settings above.
WORLD_USE=
PROD_WORLD_ISSUER=https://auth.world.org
PROD_WORLD_CLIENT_ID=
PROD_WORLD_CLIENT_SECRET=
# Only if the production client is registered with a different auth method than WORLD_CLIENT_AUTH: post or basic
PROD_WORLD_CLIENT_AUTH=
